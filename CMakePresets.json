{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Dev (Ninja, Release, tests on)",
      "description": "Day-to-day iteration. Release because the DSP tests are unusably slow otherwise.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "EE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "dev",
      "displayName": "Debug (Ninja, asserts on)",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release (universal binary, for handing to someone else)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-universal",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "EE_UNIVERSAL_BINARY": "ON",
        "EE_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    {
      "name": "tests",
      "configurePreset": "dev",
      "displayName": "Just the test binaries",
      "targets": [
        "ee_dsp_tests",
        "ee_ui_snapshot",
        "ee_tape_stress",
        "ee_reverb_stress",
        "ee_trempan_stress"
      ]
    }
  ]
}
